# ==============================================================================
# Configuración de Entorno RecicLaGo (Docker Compose & AWS Deployment)
# ==============================================================================

# Habilitar el inicio automático de los microservicios core junto con la infraestructura
COMPOSE_PROFILES=apps

# PostgreSQL
POSTGRES_DB=reciclago_db
POSTGRES_USER=reciclago
POSTGRES_PASSWORD=reciclagopass

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# Azure Active Directory (Microsoft Entra ID) - Tenant RecicLaGo
AZURE_TENANT_ID=5625266d-cae0-4070-a7ea-b5e88273580f
AZURE_CLIENT_ID=9a946a0b-5350-4fe1-a79e-ca332612f60d

# Microservicios URLs (Para comunicación interna / BFF)
RECICLAGO_SERVICES_CATALOG_URL=http://ms-catalog:8081
RECICLAGO_SERVICES_PICKUPS_URL=http://ms-pickups:8083
RECICLAGO_SERVICES_ROUTES_URL=http://ms-routes:8084

# Registro ECR de AWS (Opcional en desarrollo local, configurado automáticamente en CI/CD)
# ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
# IMAGE_TAG=latest
